# WebSocket Server URL
# 
# Local development:
# VITE_WS_URL=ws://localhost:8080
#
# Production (update with your actual WebSocket server URL):
# VITE_WS_URL=wss://your-websocket-server.com

# Remote Module Federation URLs (optional - uses localhost by default)
# VITE_MAP_REMOTE_URL=http://localhost:5001/assets/remoteEntry.js
# VITE_PERF_REMOTE_URL=http://localhost:5002/assets/remoteEntry.js
# VITE_CONTROLS_REMOTE_URL=http://localhost:5003/assets/remoteEntry.js
