{
  "name": "tactical-map-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:shell": "turbo run dev --filter=@apps/shell",
    "dev:remotes": "turbo run dev --filter='@apps/*-remote'",
    "dev:verbose": "turbo run dev --parallel --output-logs=stream",
    "build": "turbo run build",
    "build:changed": "turbo run build --filter=[HEAD^1]",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.2.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
